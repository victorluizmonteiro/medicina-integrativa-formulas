# ── Supabase ──────────────────────────────────────────────
# Painel → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://vvogybmnyhwmlleiwwym.supabase.co
# service_role (secreta — só no servidor / env vars da Vercel, NUNCA no cliente)
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (envio de e-mail) ──────────────────────────────
RESEND_API_KEY=

# ── Stripe (pagamentos) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# URL pública do site (para redirect do checkout). Local: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Upstash Redis (rate limiting) ─────────────────────────
# Opcional em dev: sem estas vars, o rate limiting é desativado (fail-open).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile (anti-bot) ───────────────────────
# Opcional em dev: sem estas vars, o CAPTCHA é desativado (fail-open).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Sentry (monitoramento de erros) ───────────────────────
# Opcional: sem DSN, o Sentry fica inativo (no-op).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
